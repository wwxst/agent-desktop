{
  "name": "agent-desktop",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0 <27"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "test": "vitest run --exclude logs/**",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "pnpm typecheck && pnpm typecheck:tests && pnpm test && pnpm check:architecture && git diff --check",
    "echo-agent": "node --experimental-transform-types examples/echo-agent/src/index.ts",
    "deepseek-agent": "node --experimental-transform-types examples/deepseek-agent/src/index.ts",
    "ffmpeg-agent": "pnpm --filter @agent-desktop/example-ffmpeg-agent start",
    "desktop:build": "pnpm --filter @agent-desktop/desktop build",
    "desktop:package:win": "pnpm --filter @agent-desktop/desktop package:win",
    "desktop:dev": "pnpm --filter @agent-desktop/desktop dev",
    "desktop": "pnpm --filter @agent-desktop/desktop start",
    "client:web": "pnpm --filter @agent-desktop/web dev",
    "client:web:build": "pnpm --filter @agent-desktop/web build",
    "client:web:test": "pnpm desktop:build && pnpm --filter @agent-desktop/web test:browser"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
