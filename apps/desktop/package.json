{
  "name": "@agent-desktop/desktop",
  "version": "0.0.2",
  "description": "本地通用智能体桌面客户端",
  "author": "wwxst",
  "private": true,
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "prepare:media": "node scripts/prepare-media.mjs",
    "build:ffmpeg": "node -e \"require('node:fs').rmSync('resources/plugins/video-editing/dist/probe-media.cjs', {force:true})\" && esbuild src/plugins/ffmpeg.ts --bundle --platform=node --target=node24 --format=cjs --outfile=resources/plugins/ffmpeg/dist/ffmpeg.cjs",
    "build:whisper": "esbuild src/plugins/whisper.ts --bundle --platform=node --target=node24 --format=cjs --outfile=resources/plugins/whisper/dist/whisper.cjs",
    "build:vision": "esbuild src/plugins/vision.ts --bundle --platform=node --target=node24 --format=cjs --outfile=resources/plugins/vision/dist/vision.cjs",
    "prepare:browser": "node scripts/prepare-playwright-browser.mjs",
    "build": "pnpm prepare:media && pnpm build:ffmpeg && pnpm build:whisper && pnpm build:vision && esbuild src/main/index.ts --bundle --platform=node --target=node24 --format=cjs --external:electron --external:electron-updater --external:@vscode/ripgrep --external:node-pty --external:playwright --external:pdfjs-dist --external:@napi-rs/canvas --external:chromium-bidi --outfile=dist/main/index.cjs && node -e \"require('node:fs').copyFileSync('src/main/windows-uia.ps1','dist/main/windows-uia.ps1')\" && esbuild src/preload/index.ts --bundle --platform=node --target=node24 --format=cjs --external:electron --outfile=dist/preload/index.cjs && vite build --config vite.config.ts",
    "package:win": "pnpm prepare:browser && pnpm build && electron-builder --win nsis --x64 --publish never",
    "start": "pnpm build && electron .",
    "dev": "node scripts/dev.mjs"
  },
  "dependencies": {
    "@agent-desktop/agent-loop": "workspace:*",
    "@agent-desktop/client": "workspace:*",
    "@agent-desktop/execution-trace": "workspace:*",
    "@agent-desktop/local-tools": "workspace:*",
    "@agent-desktop/model-deepseek": "workspace:*",
    "@agent-desktop/session": "workspace:*",
    "@agent-desktop/speech-whisper-cpp": "workspace:*",
    "@agent-desktop/tools": "workspace:*",
    "@agent-desktop/video-agent": "workspace:*",
    "@agent-desktop/video-ffmpeg": "workspace:*",
    "@agent-desktop/vision-openai": "workspace:*",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@napi-rs/canvas": "1.0.11",
    "@vscode/ripgrep": "1.18.0",
    "electron-updater": "6.8.9",
    "csv-parse": "7.0.3",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "node-pty": "1.1.0",
    "pdfjs-dist": "6.4.299",
    "playwright": "1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@agent-desktop/model": "workspace:*",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.27.4",
    "jsdom": "30.0.1",
    "vite": "8.2.2"
  }
}
