{
  "name": "@agent-desktop/desktop",
  "version": "0.0.2",
  "description": "本地通用智能体桌面客户端",
  "author": "wwxst",
  "private": true,
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build:ffmpeg": "node -e \"require('node:fs').rmSync('resources/plugins/video-editing/dist/probe-media.cjs', {force:true})\" && esbuild src/plugins/ffmpeg.ts --bundle --platform=node --target=node24 --format=cjs --outfile=resources/plugins/ffmpeg/dist/ffmpeg.cjs",
    "build:whisper": "esbuild src/plugins/whisper.ts --bundle --platform=node --target=node24 --format=cjs --outfile=resources/plugins/whisper/dist/whisper.cjs",
    "build:vision": "esbuild src/plugins/vision.ts --bundle --platform=node --target=node24 --format=cjs --outfile=resources/plugins/vision/dist/vision.cjs",
    "build": "pnpm build:ffmpeg && pnpm build:whisper && pnpm build:vision && esbuild src/main/index.ts --bundle --platform=node --target=node24 --format=cjs --external:electron --external:electron-updater --external:@vscode/ripgrep --external:node-pty --outfile=dist/main/index.cjs && esbuild src/preload/index.ts --bundle --platform=node --target=node24 --format=cjs --external:electron --outfile=dist/preload/index.cjs && vite build --config vite.config.ts",
    "package:win": "pnpm build && electron-builder --win nsis --x64 --publish never",
    "start": "pnpm build && electron .",
    "dev": "node scripts/dev.mjs"
  },
  "dependencies": {
    "@agent-desktop/agent-loop": "workspace:*",
    "@agent-desktop/client": "workspace:*",
    "@agent-desktop/execution-trace": "workspace:*",
    "@agent-desktop/local-tools": "workspace:*",
    "@agent-desktop/model-deepseek": "workspace:*",
    "@agent-desktop/session": "workspace:*",
    "@agent-desktop/speech-whisper-cpp": "workspace:*",
    "@agent-desktop/tools": "workspace:*",
    "@agent-desktop/video-agent": "workspace:*",
    "@agent-desktop/video-ffmpeg": "workspace:*",
    "@agent-desktop/vision-openai": "workspace:*",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@vscode/ripgrep": "1.18.0",
    "electron-updater": "6.8.9",
    "node-pty": "1.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@agent-desktop/model": "workspace:*",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.27.4",
    "jsdom": "30.0.1",
    "vite": "8.2.2"
  }
}
